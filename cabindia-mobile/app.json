{
  "expo": {
    "name": "CabIndia",
    "slug": "cabindia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "bundleIdentifier": "com.cabindia.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CabIndia needs your location to find nearby rides.",
        "NSLocationAlwaysUsageDescription": "CabIndia needs your location to track your ride safely.",
        "NSMotionUsageDescription": "CabIndia uses motion data to improve location accuracy and detect driving activity.",
        "GOOGLE_MAPS_API_KEY": "AIzaSyAD7ImoIAlAk6Ob9Iwyd_67UFr9lCNVTNY"
      }
    },
    "android": {
      "package": "com.cabindia.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAD7ImoIAlAk6Ob9Iwyd_67UFr9lCNVTNY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d356b644-02d4-49e6-8eeb-f50e060886c2"
      },
      "apiUrl": "https://cabindia-mobile.onrender.com",
      "socketUrl": "https://cabindia-mobile.onrender.com",
      "googleProjectId": "single-obelisk-504908-p6",
      "googleAuthUri": "https://accounts.google.com/o/oauth2/auth",
      "googleTokenUri": "https://oauth2.googleapis.com/token",
      "appName": "CabIndia",
      "appVersion": "1.0.0",
      "appEnv": "production",
      "enableGoogleLogin": true,
      "enableFacebookLogin": false,
      "enableReferralProgram": true,
      "enableCaptchaOnRegister": false
    },
    "plugins": [
      "expo-splash-screen",
      "expo-font",
      "expo-asset"
    ],
    "owner": "soul2000s"
  }
}